# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGO_URL=mongodb://localhost:27017/event-platform

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=1h

# CORS
CORS_ORIGIN=http://localhost:3000

# Email Configuration (Nodemailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=tu-email@gmail.com
MAIL_PASS=tu-contraseña-de-aplicacion
MAIL_FROM=Plataforma Eventos <tu-email@gmail.com>

# Frontend URL (para links en emails)
FRONTEND_URL=http://localhost:3000

# Passport (para futuras estrategias)
# PASSPORT_GOOGLE_CLIENT_ID=
# PASSPORT_GOOGLE_CLIENT_SECRET=
# PASSPORT_GITHUB_CLIENT_ID=
# PASSPORT_GITHUB_CLIENT_SECRET=